# ─────────────────────────────────────────────────────────────
#  Jayden Map (datecourse) — 환경변수 템플릿
#
#  ⚠️ 이 파일은 git에 커밋됩니다. 실제 값을 절대 넣지 마세요.
#     실제 값은 .env.local 에만 넣습니다.
#
#  근거: docs/05-cost-and-keys.md · docs/02-architecture.md §7
#  위치: W1에 app/ 을 만든 뒤 app/.env.example 로 옮깁니다
# ─────────────────────────────────────────────────────────────

# ── NCP Maps ─────────────────────────────────────────────────
# Console → All Services → Application Services → Maps → Application
# ⚠️ AI·NAVER API 쪽이 아닙니다 (신규 신청 차단됨)
NEXT_PUBLIC_NCP_MAP_CLIENT_ID=      # 브라우저 노출 O — 도메인 화이트리스트로 방어
NCP_MAP_CLIENT_SECRET=              # 서버 전용 (Geocoding / Directions 5)

# ── 카카오 로컬 API (장소 검색) ───────────────────────────────
# developers.kakao.com → 앱 → [카카오맵] 사용 설정 ON → 앱 키 → REST API 키
KAKAO_REST_API_KEY=                 # 서버 전용. 브라우저 노출 금지

# ── Supabase ─────────────────────────────────────────────────
# Settings → API Keys 에서 복사. 구 anon / service_role 은 2026년 말 폐기 예정
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_... 노출 정상 — 보안은 RLS가 담당
SUPABASE_SECRET_KEY=                    # sb_secret_... 서버 전용. RLS 우회 — 브라우저에서 쓰면 401

# ── 운영 (비용·버그 방어) ─────────────────────────────────────
# 500/일 × 30일 = 15,000/월 → Directions 5 무료 한도 60,000의 25%
DAILY_DIRECTIONS_LIMIT=500

# ── 선택 — 없어도 W1은 굴러갑니다 ─────────────────────────────
NAVER_SEARCH_CLIENT_ID=             # 장소 검색 폴백 (ADR-001)
NAVER_SEARCH_CLIENT_SECRET=
KMA_SERVICE_KEY=                    # 기상청. v1.0 날씨 연동

# ── Google OAuth — 여기에 넣지 않습니다 ───────────────────────
# 클라이언트 ID/Secret 은 Supabase 대시보드
#   Authentication → Providers → Google 에 직접 입력합니다.
# 리디렉션 URI 는 앱 도메인이 아니라 https://<project>.supabase.co/auth/v1/callback 입니다.
